{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9",
        "nwidart/laravel-modules": "^11.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\MoodleDash\\": "Modules/MoodleDash/app/",
            "Modules\\MoodleDash\\database\\seeders\\": "Modules/MoodleDash/database/seeders/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        },
        "audit": {
            "ignore": {
                "PKSA-mdq4-51ck-6kdq": "Laravel 11.x is affected; no patch backported to 11.x yet. Safe to ignore if not accepting CRLF in email validation inputs.",
                "CVE-2026-48019": "Laravel 11.x is affected; no patch backported to 11.x yet. Safe to ignore if not accepting CRLF in email validation inputs.",
                "GHSA-5vg9-5847-vvmq": "Laravel 11.x is affected; no patch backported to 11.x yet. Safe to ignore if not accepting CRLF in email validation inputs."
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
